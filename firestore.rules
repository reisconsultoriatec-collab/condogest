rules_version = '2';

// =============================================================================
// CondoGest — Regras do Firestore (Fase 3: separação entre condomínios e matriz
// de permissões aplicada no servidor)
// -----------------------------------------------------------------------------
// O que muda em relação à Fase 2:
//   1. Cada pessoa só lê e grava os condomínios marcados em "Condomínios
//      Permitidos" no cadastro dela. O administrador continua vendo todos.
//   2. Gravar, alterar e excluir seguem a matriz da tela de Usuários (Incluir,
//      Alterar, Excluir), também no servidor, e não só na tela.
//   3. Categorias de Despesas, áreas comuns e configuração dos hidrômetros
//      seguem a matriz da tela correspondente.
//   4. Quem cria a própria conta não consegue mais se dar permissões, condomínios
//      ou apartamento: o perfil nasce vazio e só o administrador o completa.
//   5. A trilha de auditoria só aceita o próprio e-mail e a hora do servidor.
//
// ATENÇÃO antes de publicar:
//   - Todo usuário que não é administrador precisa ter o condomínio marcado em
//     "Condomínios Permitidos". Sem isso, ele não enxerga condomínio nenhum.
//   - Teste no "Simulador de regras" do console com o roteiro do fim do arquivo.
//   - A versão anterior (Fase 2) fica no histórico do GitHub e do próprio
//     console do Firebase: dá para voltar com um clique se algo falhar.
//
// Leitura das coleções por apartamento: a equipe (perfis que não são morador)
// continua lendo o condomínio todo, porque o app usa moradores, pagamentos e
// taxas em várias telas ao mesmo tempo. O morador continua lendo só a própria
// unidade.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Auxiliares ----------

    function logado() {
      return request.auth != null;
    }

    function perfilDoc() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function temPerfil() {
      return logado() && exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid));
    }

    // .get(campo, padrao) evita erro quando o perfil é antigo e não tem o campo
    function status()  { return perfilDoc().get('status', 'ativo'); }
    function papel()   { return perfilDoc().get('perfil', 'usuario'); }
    function meuApto() { return perfilDoc().get('apartamentoVinculado', ''); }
    function aprovado() { return perfilDoc().get('aprovado', true) == true; }

    // Conta válida: existe, está aprovada e não foi desativada
    function ativo() {
      return temPerfil() && status() != 'inativo' && aprovado();
    }

    function admin()   { return ativo() && papel() == 'admin'; }
    function gestor()  { return ativo() && (papel() == 'admin' || papel() == 'sindico'); }
    function morador() { return ativo() && papel() == 'morador'; }
    function equipe()  { return ativo() && papel() != 'morador'; }

    function moradorComApto() {
      return morador() && meuApto() != '';
    }

    // ----- Condomínio -----
    // O administrador vê todos. Os demais, só os marcados no cadastro.
    function noCondo(cid) {
      return admin() || (ativo() && perfilDoc().get('condosPermitidos', []).hasAny([cid]));
    }

    // ----- Matriz de permissões -----
    // Lê a mesma matriz que o app grava em 'acessos' (tela -> ver, criar,
    // alterar, excluir). Perfis antigos, sem 'acessos', seguem a regra anterior:
    // a tela em 'permissoes' libera todas as ações dela. Gestor pode tudo.
    function semMatriz() {
      return perfilDoc().get('acessos', null) == null;
    }
    function naMatriz(tela, acao) {
      return (semMatriz() && perfilDoc().get('permissoes', []).hasAny([tela]))
          || (!semMatriz() && perfilDoc().get(['acessos', tela, acao], false) == true);
    }
    function pode(tela, acao) {
      return gestor() || (ativo() && naMatriz(tela, acao));
    }
    // Ver uma tela (coluna "Ver"; o app também grava essa coluna em 'permissoes')
    function veTela(tela) {
      return ativo() && (gestor() || perfilDoc().get('permissoes', []).hasAny([tela]));
    }
    // Permissões especiais da tela de Usuários
    function especial(nome) {
      return ativo() && perfilDoc().get('permissoes', []).hasAny([nome]);
    }
    // Categorias de Despesas era uma aba de Configurações: quem ainda não tem a
    // linha própria na matriz herda a de Configurações (como no app). A lista é
    // gravada inteira ao incluir e ao excluir, então vale qualquer das duas.
    function categoriasNaMatriz(acao) {
      return perfilDoc().get(['acessos', 'categorias', acao], perfilDoc().get(['acessos', 'configuracoes', acao], false)) == true;
    }
    function podeCategorias() {
      return gestor() || (ativo() && (
           (semMatriz() && perfilDoc().get('permissoes', []).hasAny(['categorias', 'configuracoes']))
        || (!semMatriz() && (categoriasNaMatriz('criar') || categoriasNaMatriz('excluir')))));
    }

    // Gravação de uma coleção do condomínio pela equipe, conforme a matriz
    function equipeCria(tela)   { return equipe() && pode(tela, 'criar'); }
    function equipeAltera(tela) { return equipe() && pode(tela, 'alterar'); }
    function equipeExclui(tela) { return equipe() && pode(tela, 'excluir'); }

    // ---------- Perfis de usuário ----------
    match /user_profiles/{uid} {
      // Cada um lê o próprio perfil; a lista completa é só do administrador
      // (só ele altera usuários; para o síndico a tela fica vazia, sem erro)
      allow get:  if logado() && (request.auth.uid == uid || admin());
      allow list: if admin();

      // Primeiro login: o app cria o próprio perfil, pendente e sem nenhum poder.
      // Os campos são conferidos um a um: ninguém se dá permissões, condomínios
      // nem apartamento ao se cadastrar.
      allow create: if (admin())
        || (logado()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nome', 'email', 'perfil', 'permissoes', 'condosPermitidos', 'status', 'aprovado', 'criadoEm', 'criadoPor'])
          && request.resource.data.perfil == 'usuario'
          && request.resource.data.status == 'pendente'
          && request.resource.data.aprovado == false
          && request.resource.data.get('permissoes', []) == ['dashboard']
          && request.resource.data.get('condosPermitidos', []) == []
          && request.resource.data.email.lower() == request.auth.token.email.lower());

      // Só o administrador altera perfil, permissões, status e apartamento
      allow update, delete: if admin();
    }

    // ---------- Condomínios ----------
    match /condominios/{cid} {
      // O app de quem não é administrador busca cada condomínio permitido pelo ID
      allow get:    if noCondo(cid);
      allow list:   if admin();
      allow create: if admin();
      allow update: if admin() || (gestor() && noCondo(cid));
      allow delete: if admin();

      // ===== Coleções do condomínio inteiro =====
      // Leitura: quem tem "Ver" em alguma tela que usa a coleção.
      // Gravação: equipe, conforme a matriz da tela que lança aquela coleção.
      match /contas/{doc} {
        allow read:   if noCondo(cid) && (veTela('contas') || veTela('relDespesas') || veTela('balancete'));
        allow create: if noCondo(cid) && equipeCria('contas');
        allow update: if noCondo(cid) && equipeAltera('contas');
        allow delete: if noCondo(cid) && equipeExclui('contas');
      }
      match /extrato/{doc} {
        allow read:   if noCondo(cid) && (veTela('conciliacao') || veTela('relConciliacao') || veTela('balancete'));
        allow create: if noCondo(cid) && equipeCria('conciliacao');
        allow update: if noCondo(cid) && equipeAltera('conciliacao');
        allow delete: if noCondo(cid) && equipeExclui('conciliacao');
      }
      match /orcamento/{doc} {
        allow read:   if noCondo(cid) && (veTela('orcamento') || veTela('balancete'));
        allow create: if noCondo(cid) && equipeCria('orcamento');
        allow update: if noCondo(cid) && equipeAltera('orcamento');
        allow delete: if noCondo(cid) && equipeExclui('orcamento');
      }
      match /receitas_avulsas/{doc} {
        allow read:   if noCondo(cid) && (veTela('receitasAvulsas') || veTela('relReceitas') || veTela('balancete'));
        allow create: if noCondo(cid) && equipeCria('receitasAvulsas');
        allow update: if noCondo(cid) && equipeAltera('receitasAvulsas');
        allow delete: if noCondo(cid) && equipeExclui('receitasAvulsas');
      }
      match /responsaveis/{doc} {
        allow read:   if noCondo(cid) && veTela('responsaveis');
        allow create: if noCondo(cid) && equipeCria('responsaveis');
        allow update: if noCondo(cid) && equipeAltera('responsaveis');
        allow delete: if noCondo(cid) && equipeExclui('responsaveis');
      }
      match /fornecedores/{doc} {
        allow read:   if noCondo(cid) && veTela('fornecedores');
        allow create: if noCondo(cid) && equipeCria('fornecedores');
        allow update: if noCondo(cid) && equipeAltera('fornecedores');
        allow delete: if noCondo(cid) && equipeExclui('fornecedores');
      }

      // ===== Coleções por apartamento =====
      // Leitura: a equipe vê o condomínio todo; o morador só a própria unidade.
      match /moradores/{doc} {
        allow read:   if noCondo(cid) && (equipe() || (moradorComApto() && resource.data.apto == meuApto()));
        allow create: if noCondo(cid) && equipeCria('moradores');
        allow update: if noCondo(cid) && equipeAltera('moradores');
        allow delete: if noCondo(cid) && equipeExclui('moradores');
      }
      match /pagamentos/{doc} {
        allow read:   if noCondo(cid) && (equipe() || (moradorComApto() && resource.data.apto == meuApto()));
        // A conciliação assistida também lança pagamentos: vale a matriz de Pagamentos
        allow create: if noCondo(cid) && equipeCria('pagamentos');
        allow update: if noCondo(cid) && equipeAltera('pagamentos');
        allow delete: if noCondo(cid) && equipeExclui('pagamentos');
      }
      match /taxas_apartamento/{doc} {
        allow read:  if noCondo(cid) && (equipe() || (moradorComApto() && resource.data.apto == meuApto()));
        // A aba "Taxas por Apartamento" só aparece para administrador e síndico
        allow write: if noCondo(cid) && gestor();
      }
      match /hidrometros/{doc} {
        allow read:   if noCondo(cid) && (equipe() || (moradorComApto() && resource.data.unidade == meuApto()));
        allow create: if noCondo(cid) && equipeCria('hidrometros');
        allow update: if noCondo(cid) && equipeAltera('hidrometros');
        allow delete: if noCondo(cid) && equipeExclui('hidrometros');
      }
      // Cancelamento de parcelas: administrador ou quem tem a permissão especial
      match /inad_exclusoes/{doc} {
        allow read:  if noCondo(cid) && (equipe() || (moradorComApto() && resource.data.apto == meuApto()));
        allow write: if noCondo(cid) && (admin() || especial('inadExcluir'));
      }
      // Isenção de multa e juros: gestor ou quem tem a permissão especial
      match /encargos_isencoes/{doc} {
        allow read:  if noCondo(cid) && (equipe() || (moradorComApto() && resource.data.apto == meuApto()));
        allow write: if noCondo(cid) && (gestor() || especial('encargosIsentar'));
      }

      // ===== Ocorrências: o morador abre e acompanha as dele =====
      match /ocorrencias/{doc} {
        allow read:   if noCondo(cid) && (equipe() || (moradorComApto() && resource.data.solicitante == meuApto()));
        allow create: if noCondo(cid) && (equipeCria('ocorrencias')
          || (moradorComApto() && pode('ocorrencias', 'criar') && request.resource.data.solicitante == meuApto()));
        allow update: if noCondo(cid) && equipeAltera('ocorrencias');
        allow delete: if noCondo(cid) && equipeExclui('ocorrencias');
      }

      // ===== Reservas: agenda compartilhada das áreas comuns =====
      // Todos do condomínio enxergam a agenda (é como o app evita conflito de
      // horário). O morador só mexe nas reservas da própria unidade.
      match /reservas/{doc} {
        allow read:   if noCondo(cid);
        allow create: if noCondo(cid) && (equipeCria('reservas')
          || (moradorComApto() && pode('reservas', 'criar') && request.resource.data.solicitante == meuApto()));
        allow update: if noCondo(cid) && (equipeAltera('reservas')
          || (moradorComApto() && pode('reservas', 'alterar') && resource.data.solicitante == meuApto() && request.resource.data.solicitante == meuApto()));
        allow delete: if noCondo(cid) && (equipeExclui('reservas')
          || (moradorComApto() && pode('reservas', 'excluir') && resource.data.solicitante == meuApto()));
      }

      // ===== Conteúdo do condomínio, visível a todos do condomínio =====
      match /comunicados/{doc} {
        allow read:   if noCondo(cid);
        allow create: if noCondo(cid) && equipeCria('comunicados');
        allow update: if noCondo(cid) && equipeAltera('comunicados');
        allow delete: if noCondo(cid) && equipeExclui('comunicados');
      }
      match /assembleias/{doc} {
        allow read:   if noCondo(cid);
        allow create: if noCondo(cid) && equipeCria('assembleias');
        allow update: if noCondo(cid) && equipeAltera('assembleias');
        allow delete: if noCondo(cid) && equipeExclui('assembleias');
      }
      match /taxas/{doc} {
        allow read:   if noCondo(cid);
        allow create: if noCondo(cid) && equipeCria('taxas');
        allow update: if noCondo(cid) && equipeAltera('taxas');
        allow delete: if noCondo(cid) && equipeExclui('taxas');
      }

      // ===== Configurações =====
      // Todos do condomínio leem (o boleto do morador usa settings/encargos).
      match /settings/categorias {
        allow read:  if noCondo(cid);
        allow write: if noCondo(cid) && podeCategorias();
      }
      match /settings/areas_comuns {
        allow read:  if noCondo(cid);
        allow write: if noCondo(cid) && (gestor() || equipeAltera('reservas'));
      }
      match /settings/hidrometro_config {
        allow read:  if noCondo(cid);
        allow write: if noCondo(cid) && (gestor() || equipeAltera('hidrometros'));
      }
      // Multa e juros e qualquer outra configuração: administrador e síndico
      match /settings/{outra} {
        allow read:  if noCondo(cid);
        allow write: if noCondo(cid) && gestor();
      }

      // Qualquer coleção futura fica restrita a administrador e síndico do
      // condomínio até ganhar uma regra própria: nada nasce aberto.
      match /{colecao}/{doc=**} {
        allow read, write: if noCondo(cid) && gestor();
      }
    }

    // ---------- Trilha de auditoria ----------
    // Todo usuário logado grava o próprio registro, com o e-mail dele e a hora
    // do servidor. Ninguém altera nem apaga. Leitura só do administrador.
    match /audit_trail/{doc} {
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'action', 'condoId', 'details', 'timestamp', 'ip'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.timestamp == request.time;
      allow read:   if admin();
      allow update, delete: if false;
    }

    // ---------- Teste de conexão (Configurações) ----------
    match /_test_connection/ping {
      allow read, write: if gestor();
    }

    // Nada mais é acessível
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// =============================================================================
// ROTEIRO DE TESTE (console do Firebase > Firestore > Regras > Simulador)
// -----------------------------------------------------------------------------
// Use o ID real do condomínio no lugar de {cid}. Para os testes de outros
// perfis, crie em user_profiles três documentos de teste (e apague depois):
//   S) teste_sindico  -> { perfil: 'sindico', status: 'ativo', aprovado: true,
//                         condosPermitidos: ['{cid}'] }
//   M) teste_morador  -> { perfil: 'morador', status: 'ativo', aprovado: true,
//                         condosPermitidos: ['{cid}'], apartamentoVinculado: '12',
//                         permissoes: ['dashboard','ocorrencias','reservas'] }
//   V) teste_visual   -> { perfil: 'visualizador', status: 'ativo', aprovado: true,
//                         condosPermitidos: ['{cid}'], permissoes: ['dashboard','pagamentos'],
//                         acessos: { pagamentos: { ver: true, criar: false, alterar: false, excluir: false } } }
// No simulador, marque "Autenticado" e use o ID do documento como UID.
//
// Com a SUA conta de administrador (tudo deve PASSAR):
//   - get    /condominios/{cid}
//   - list   /condominios
//   - create /condominios/{cid}/pagamentos/teste
//   - list   /user_profiles
//
// Síndico S (deve PASSAR):
//   - get    /condominios/{cid}
//   - create /condominios/{cid}/contas/teste
// Síndico S (deve FALHAR):
//   - get    /condominios/outro_condominio
//   - get    /condominios/outro_condominio/moradores/qualquer
//   - list   /condominios
//   - list   /user_profiles
//
// Morador M (deve PASSAR):
//   - list   /condominios/{cid}/pagamentos     com where apto == '12'
//   - create /condominios/{cid}/ocorrencias    com solicitante == '12'
// Morador M (deve FALHAR):
//   - list   /condominios/{cid}/pagamentos     SEM where
//   - create /condominios/{cid}/ocorrencias    com solicitante == '15'
//
// Visualizador V (deve PASSAR):
//   - get    /condominios/{cid}/pagamentos/qualquer
// Visualizador V (deve FALHAR):
//   - create /condominios/{cid}/pagamentos/teste   <- a matriz não libera "Incluir"
//   - delete /condominios/{cid}/pagamentos/qualquer
//
// Sem login (deve FALHAR): qualquer leitura.
// Depois de publicar, entre no app com a sua conta e confira se todas as telas
// carregam. Se algo falhar, volte a versão anterior das regras no console.
// =============================================================================
